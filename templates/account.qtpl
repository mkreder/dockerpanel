{% import "github.com/mkreder/dockerpanel/model" %}
{% import "strconv" %}
{% func AccountTemplate(accounts []model.Account, domain model.Domain, error string) %}

<!DOCTYPE html>
<html lang="en">
<script type="text/javascript">
    var timeoutVar;

    function activateTimeout() {
        timeoutVar = setTimeout(function() {
            window.location.href = window.location.href;
        }, 5000);
    }
    activateTimeout()

    function desactivateTimeout() {
        clearTimeout(timeoutVar);
    }

    function validateForm() {
        var y = document.getElementById("name").value;
        if (y == "" ) {
            alert("Account name must be completed");
            return false;
        }

        var y = document.getElementById("nameReal").value;
        if (y == "" ) {
            alert("Account real name must be completed");
            return false;
        }

        if ( document.getElementById('aractivado').checked ) {
            var a = document.getElementById("fechaInicio").value;
            if (a == "" ) {
                alert("must be completed la fecha de inicio");
                return false;
            }

            var b = document.getElementById("fechaFin").value;
            if (b == "" ) {
                alert("must be completed la fecha de fin");
                return false;
            }

            var d = document.getElementById("asunto").value;
            if (c == "" ) {
                alert("must be completed el asunto");
                return false;
            }

            var d = document.getElementById("mensaje").value;
            if (d == "" ) {
                alert("Message must be completed");
                return false;
            }
        }

        if ( document.getElementById('renvioactive').checked ) {
            var e = document.getElementById("direccionRenvio").value;
            if (e == "" ) {
                alert("must be completed la dirección de renvío");
                return false;
            }

        }

        var z = document.getElementById("password").value;
        if ( document.getElementById("password").getAttribute("disabled") == "disabled" ){
            } else {
            if (z == "" ) {
                alert("Password must be completed");
                return false;
            }
        }

    }

    function generatePassword() {
        if ( document.getElementById("password").getAttribute("disabled") == "disabled" ) {
            document.getElementById("btngenerar").innerHTML="Generate";
            document.getElementById("password").removeAttribute("disabled")
            document.getElementById("checkmostrar").removeAttribute("disabled");
        } else {
            document.getElementById("password").value = Math.random().toString(36).slice(-8);
        }
    }

    function showPassword() {
        if ( document.getElementById('checkmostrar').checked ) {
            document.getElementById('password').removeAttribute("type")
        } else {
            document.getElementById('password').setAttribute("type","password")
        }

    }


    function showDiv() {
        var x = document.getElementById('form');
        x.style.display = 'block';
        desactivateTimeout()
    }


    function hideDiv() {
        var x = document.getElementById('form');
        x.style.display = 'none';
        document.getElementById("name").value = "";
        document.getElementById("nameReal").value = "";
        document.getElementById("password").value = "";
        document.getElementById("cuota").value = "";
        document.getElementById("accountdefecto").checked = false;
        document.getElementById("aractivado").checked = false;
        document.getElementById("fechaInicio").value = "";
        document.getElementById("fechaFin").value = "";
        document.getElementById("mensaje").value = "";
        document.getElementById("asunto").value = "";
        document.getElementById("renvioactive").checked = false;
        document.getElementById("direccionRenvio").value = "";
        document.getElementById("fechaInicio").setAttribute("disabled","disabled")
        document.getElementById("fechaFin").setAttribute("disabled","disabled")
        document.getElementById("asunto").setAttribute("disabled","disabled")
        document.getElementById("mensaje").setAttribute("disabled","disabled")
        document.getElementById("direccionRenvio").setAttribute("disabled","disabled")

        if ( document.getElementById("password").getAttribute("disabled") == "disabled" ) {
            document.getElementById("btngenerar").innerHTML="Generate";
            document.getElementById("password").removeAttribute("disabled");
            document.getElementById("checkmostrar").removeAttribute("disabled");
        }
        activateTimeout()
    }

    function modifyAccount(id,name,nameReal,cuota,accountdefecto,aractivado,fechaInicio,fechaFIn,mensaje,asunto,renvio ){
        var x = document.getElementById('form');
        document.getElementById("id").value = id;
        document.getElementById("name").value = name;
        document.getElementById("nameReal").value = nameReal;
        document.getElementById("cuota").value = cuota;

        if ( accountdefecto == "si" ) {
            document.getElementById("accountdefecto").checked = true;
            document.getElementById("direccionRenvio").removeAttribute("disabled")
        } else {
            document.getElementById("accountdefecto").checked = false;
            document.getElementById("direccionRenvio").setAttribute("disabled","disabled")
        }

        if ( aractivado == "true" ) {
            document.getElementById("aractivado").checked = true;
            document.getElementById("fechaInicio").removeAttribute("disabled")
            document.getElementById("fechaFin").removeAttribute("disabled")
            document.getElementById("asunto").removeAttribute("disabled")
            document.getElementById("mensaje").removeAttribute("disabled")
        } else {
            document.getElementById("aractivado").checked = false;
            document.getElementById("fechaInicio").setAttribute("disabled","disabled")
            document.getElementById("fechaFin").setAttribute("disabled","disabled")
            document.getElementById("asunto").setAttribute("disabled","disabled")
            document.getElementById("mensaje").setAttribute("disabled","disabled")

        }

        document.getElementById("fechaInicio").value = fechaInicio;
        document.getElementById("fechaFin").value = fechaFIn;
        document.getElementById("mensaje").value = mensaje.replace(/(?:;)/g, '\n');
        document.getElementById("asunto").value = asunto;

        if ( renvio == "" ){
            document.getElementById("renvioactive").checked = false;
        }else {
            document.getElementById("renvioactive").checked = true;
            document.getElementById("direccionRenvio").value = renvio;
        }


        document.getElementById("password").setAttribute("disabled","disabled")
        document.getElementById("btngenerar").innerHTML="Change";
        document.getElementById("checkmostrar").setAttribute("disabled","disabled")
        x.style.display = 'block';
        desactivateTimeout()
    }

    function activateForward() {
        if (document.getElementById('renvioactive').checked) {
            document.getElementById("direccionRenvio").removeAttribute("disabled");
        } else {
            document.getElementById("direccionRenvio").setAttribute("disabled","disabled")
            document.getElementById("direccionRenvio").value = "";
        }
    }

    function activateAutoresponder() {
        if (document.getElementById('aractivado').checked) {
            document.getElementById("fechaInicio").removeAttribute("disabled");
            document.getElementById("fechaFin").removeAttribute("disabled");
            document.getElementById("mensaje").removeAttribute("disabled");
            document.getElementById("asunto").removeAttribute("disabled");
        } else {
            document.getElementById("fechaInicio").setAttribute("disabled","disabled")
            document.getElementById("fechaFin").setAttribute("disabled","disabled")
            document.getElementById("mensaje").setAttribute("disabled","disabled")
            document.getElementById("asunto").setAttribute("disabled","disabled")
            document.getElementById("fechaInicio").value = "";
            document.getElementById("fechaFin").value = "";
            document.getElementById("mensaje").value = "";
            document.getElementById("asunto").value = "Fuera de la oficina";
        }
    }

</script>
<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Docker Panel</title>

    <!-- Bootstrap Core CSS -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <!-- MetisMenu CSS -->
    <link href="/vendor/metisMenu/metisMenu.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="/dist/css/sb-admin-2.css" rel="stylesheet">

    <!-- Morris Charts CSS -->
    <link href="/vendor/morrisjs/morris.css" rel="stylesheet">

    <!-- Custom Fonts -->
    <link href="/vendor/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css">

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
    <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->

</head>

<body>

{% if len(error) > 0 %}
<script type="text/javascript">
    window.alert("{%s error %}")
</script>
{% endif %}

<div id="wrapper">

    <!-- Navigation -->
    <nav class="navbar navbar-default navbar-static-top" role="navigation" style="margin-bottom: 0">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand" >Docker Panel</a>
        </div>
        <!-- /.navbar-header -->

        <ul class="nav navbar-top-links navbar-right">
            <!-- /.dropdown -->
            <li class="dropdown">
                <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                    <i class="fa fa-user fa-fw"></i> <i class="fa fa-caret-down"></i>
                </a>
                <ul class="dropdown-menu dropdown-user">
                    <li><a href="/profile"><i class="fa fa-user fa-fw"></i> Settings</a>
                    </li>
                    <li class="divider"></li>
                    <li><a href="/logout"><i class="fa fa-sign-out fa-fw"></i> Logout</a>
                    </li>
                </ul>
                <!-- /.dropdown-user -->
            </li>
            <!-- /.dropdown -->
        </ul>
        <!-- /.navbar-top-links -->


        <div class="navbar-default sidebar" role="navigation">
            <div class="sidebar-nav navbar-collapse">
                <ul class="nav" id="side-menu">
                    <li>
                        <a href="/"><i class="fa fa-dashboard fa-fw"></i>Dashboard</a>
                    </li>
                    <li>
                        <a href="/web"><i class="fa fa-server fa-fw"></i>Websites</a>
                    </li>
                    <li>
                        <a href="/dns"><i class="fa fa-cloud fa-fw"></i>DNS</a>
                    </li>
                    <li>
                        <a href="/db"><i class="fa fa-database fa-fw"></i>Databases</a>
                    </li>
                    <li>
                        <a href="/mail"><i class="fa fa-at fa-fw"></i>E-Mail</a>
                    </li>
                    <li>
                        <a href="/ftp"><i class="fa fa-file-archive-o fa-fw"></i>FTP Users</a>
                    </li>
                </ul>
            </div>
            <!-- /.sidebar-collapse -->
        </div>
            <!-- /.sidebar-collapse -->
        </div>
        <!-- /.navbar-static-side -->
    </nav>

    <div id="page-wrapper">
        <br>
        <div class="row">
            <div class="col-lg-12">
                <div class="panel panel-default">
                    <div class="panel-heading clearfix">
                        <h4 class="panel-title pull-left" style="padding-top: 7.5px;">Email Accounts</h4>
                        <button type="button" class="btn pull-right btn-primary btn-sm" onclick="showDiv()">Add</button>
                    </div>
                    <!-- /.panel-heading -->
                    <div class="panel-body">
                        <table width="100%" class="table table-striped table-bordered table-hover" id="dataTables-example">
                            <thead>
                            <tr>
                                <th>Cuenta</th>
                                <th>Name real</th>
                                <th>Cuota</th>
                                <th>Auto-responder</th>
                                <th>Default Account</th>
                                <th>Email Forward</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for _, account := range accounts %}
                            <tr class="odd gradeX">
                                <td> {%s account.Name %}@{%s domain.Name %} </td>
                                <td> {%s account.RealName %} </td>

                                {% if account.Quota == 0 %}
                                <td> ilimitada </td>
                                {% else %}
                                <td> {%d account.Quota %} MB </td>
                                {% endif %}

                                <td>
                                    {% if (account.Autoresponder.Enabled == true)%}
                                        si
                                    {% else %}
                                        no
                                    {% endif %}
                                </td>
                                <td>
                                    {% code
                                        accountdefecto := "no"
                                    %}
                                    {% if account.Name == domain.DefaultAccount %}
                                        si
                                    {% code
                                        accountdefecto = "si"
                                    %}
                                    {% else %}
                                        no
                                    {% endif %}
                                </td>
                                <td>
                                    {% if len(account.Forward) > 0 %}
                                        si
                                    {% else %}
                                        no
                                    {% endif %}
                                </td>
                                <td class="center">
                                    <button type="button" class="btn btn-xs btn-primary" data-toggle="tooltip" data-placement="top" title="Modify email account" onclick='modifyAccount({%d int(account.ID) %}, "{%s account.Name %}", "{%s account.RealName %}","{%d account.Quota %}", "{%s accountdefecto %}", "{%s strconv.FormatBool(account.Autoresponder.Enabled) %}", "{%s account.Autoresponder.StartDate %}", "{%s account.Autoresponder.EndDate %}", "{%s account.Autoresponder.Message %}", "{%s account.Autoresponder.Subject %}", "{%s account.Forward %}" )' ><i class="fa fa-list"></i></button>
                                    <button class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete account de correo" onclick="location.href='removeCuenta?id={%d int(account.ID) %}&domainid={%d int(domain.ID) %}';"><i class="fa fa-trash-o"></i></button>
                                </td>
                            </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>


        <div id="form" class="col-lg-6" hidden="true" >
            <div class="panel panel-default">
                <div class="panel-heading">
                    Settings de la account de Correo
                </div>
                <div class="panel-body">
                    <form id="addftp" action="/addCuenta" onsubmit="return validateForm()" role=form method="post">

                        <input id="id" name="id" hidden="true" >
                        <input id="domainid" name="domainid" hidden="true" value="{%d int(domain.ID) %}">

                        <ul class="nav nav-tabs">
                            <li class="active"><a href="#basica" data-toggle="tab">Settings básica</a>
                            </li>
                            <li><a href="#autoresponder" data-toggle="tab">Auto-responder</a>
                            </li>
                            <li><a href="#renvio" data-toggle="tab">Reenvio de correo</a>
                            </li>
                        </ul>

                        <!-- Tab panes -->
                        <div class="tab-content">
                            <div class="tab-pane fade in active" id="basica">
                                Name de la account
                                <input class="form-control" name="name" id="name">
                                Name real
                                <input class="form-control" name="nameReal" id="nameReal">
                                <br>

                                Password
                                <input class="form-control" name="password" id="password" type="password">
                                <button id="btngenerar" type="button" class="btn btn-default btn-sm" onclick="generatePassword()">Generate</button>
                                <input id="checkmostrar" name="checkmostrar" type="checkbox" value="true" onclick="showPassword()"> Show Password
                                <br>

                                <br>
                                Cuota
                                <input id="cuota" type="number" name="cuota" min="0" placeholder="0" value="0" >MB  (0 = ilimitado)
                                <br>

                                <div class="checkbox">
                                    <label>
                                        <input id="accountdefecto" name="accountdefecto" type="checkbox" value="true"> Receive mail from non-existent mailboxes
                                    </label>
                                </div>

                            </div>

                            <div class="tab-pane fade" id="autoresponder">
                                <div class="checkbox">
                                    <label>
                                        <input id="aractivado" name="aractivado" type="checkbox" value="true" onclick="activateAutoresponder()"> Activado
                                    </label>
                                </div>
                                Fecha inicio
                                <input class="form-control" id="fechaInicio" name="fechaInicio" type="date" disabled="disabled">
                                Fecha fin
                                <input class="form-control" id="fechaFin" name="fechaFin" type="date" disabled="disabled">
                                <br>
                                Asunto
                                <input class="form-control" name="asunto" id="asunto" value="Fuera de la oficina" placeholder="Fuera de la oficina" disabled="disabled">
                                <br>
                                Mensaje
                                <br>
                                <textarea id="mensaje" name="mensaje" cols="50" rows="10" disabled="disabled"></textarea>
                            </div>


                            <div class="tab-pane fade" id="renvio">
                                <div class="checkbox">
                                    <label>
                                        <input id="renvioactive" name="renvioactive" type="checkbox" value="true" onclick="activateForward()"> Activado
                                    </label>
                                </div>
                                Dirección de reenvío
                                <input class="form-control" name="direccionRenvio" id="direccionRenvio" disabled="disabled">

                            </div>



                        </div>
                        <br>
                        <button type="submit" class="btn btn-default">Save</button>
                        <button type="button" class="btn btn-default" onclick="hideDiv()">Cancel</button>
                    </form>
                </div>
            </div>

        </div>
        <!-- /#page-wrapper -->

    </div>
    <!-- /#wrapper -->

    <!-- jQuery -->
    <script src="/vendor/jquery/jquery.min.js"></script>

    <!-- Bootstrap Core JavaScript -->
    <script src="/vendor/bootstrap/js/bootstrap.min.js"></script>

    <!-- Metis Menu Plugin JavaScript -->
    <script src="/vendor/metisMenu/metisMenu.min.js"></script>

    <!-- Morris Charts JavaScript -->
    <!--<script src="/vendor/raphael/raphael.min.js"></script>-->
    <!--<script src="/vendor/morrisjs/morris.min.js"></script>-->
    <!--<script src="../data/morris-data.js"></script>-->

    <!-- Custom Theme JavaScript -->
    <script src="/dist/js/sb-admin-2.js"></script>

</body>

</html>

{% endfunc %}
