{% import "github.com/mkreder/dockerpanel/model" %}
{% func RecordTemplate(records []model.Record, zoneid string, error string) %}

<!DOCTYPE html>
<html lang="en">
<script type="text/javascript">
    var timeoutVar;

    function activateTimeout() {
        timeoutVar = setTimeout(function() {
            window.location.href = window.location.href;
        }, 5000);
    }
    activateTimeout()

    function desactivateTimeout() {
        clearTimeout(timeoutVar);
    }

    function validateForm() {
        var x = document.getElementById("name").value;
        if (x == "" ) {
            alert("Name must be completed");
            return false;
        }

        var y = document.getElementById("value").value;
        if (y == "" ) {
            alert("Value must be completed");
            return false;
        }

        if ( document.getElementById("type").value == "MX" ) {
            var z = document.getElementById("priority").value;
            if (z == "") {
                alert("Priority must be completed");
                return false;
            }

            if (/^[0-9]*$/.test(z)) {
            } else {
                alert("Priority must be a numeric value");
                return false;
            }

        }



    }

    function showDiv() {
        var x = document.getElementById('form');
        x.style.display = 'block';
        desactivateTimeout()
    }


    function hideDiv() {
        var x = document.getElementById('form');
        x.style.display = 'none';
        document.getElementById("type").options[0].selected = true;
        document.getElementById("name").value = "";
        document.getElementById("value").value = "";
        document.getElementById("priority").value = "";
        document.getElementById("id").value = "";
        document.getElementById("priority").setAttribute("disabled","disabled")
        activateTimeout()
    }

    function modifyRecord(id,type,name,value,priority) {
        var x = document.getElementById('form');
        document.getElementById("id").value = id;
        var seltype = document.getElementById("type");


        for (var i = 0; i < seltype.options.length; i++) {
            if (seltype.options[i].text== type) {
                seltype.options[i].selected = true;
            }
        }
        document.getElementById("name").value = name;
        document.getElementById("value").value = value;
        if ( type == "MX" ){
            document.getElementById("priority").removeAttribute("disabled")
            document.getElementById("priority").value = priority;
        }

        x.style.display = 'block';
        desactivateTimeout()
    }

    function activatePriority(){
        if ( document.getElementById("type").value == "MX" ){
            document.getElementById("priority").removeAttribute("disabled")
        } else {
            document.getElementById("priority").setAttribute("disabled","disabled")
        }
    }

</script>
<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Docker Panel</title>

    <!-- Bootstrap Core CSS -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <!-- MetisMenu CSS -->
    <link href="/vendor/metisMenu/metisMenu.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="/dist/css/sb-admin-2.css" rel="stylesheet">

    <!-- Morris Charts CSS -->
    <link href="/vendor/morrisjs/morris.css" rel="stylesheet">

    <!-- Custom Fonts -->
    <link href="/vendor/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css">

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
    <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->

</head>

<body>

{% if len(error) > 0 %}
<script type="text/javascript">
    window.alert("{%s error %}")
</script>
{% endif %}

<div id="wrapper">

    <!-- Navigation -->
    <nav class="navbar navbar-default navbar-static-top" role="navigation" style="margin-bottom: 0">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand" >Docker Panel</a>
        </div>
        <!-- /.navbar-header -->

        <ul class="nav navbar-top-links navbar-right">
            <!-- /.dropdown -->
            <li class="dropdown">
                <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                    <i class="fa fa-user fa-fw"></i> <i class="fa fa-caret-down"></i>
                </a>
                <ul class="dropdown-menu dropdown-user">
                    <li><a href="/profile"><i class="fa fa-user fa-fw"></i> Settings</a>
                    </li>
                    <li class="divider"></li>
                    <li><a href="/logout"><i class="fa fa-sign-out fa-fw"></i> Logout</a>
                    </li>
                </ul>
                <!-- /.dropdown-user -->
            </li>
            <!-- /.dropdown -->
        </ul>
        <!-- /.navbar-top-links -->


        <div class="navbar-default sidebar" role="navigation">
            <div class="sidebar-nav navbar-collapse">
                <ul class="nav" id="side-menu">
                    <li>
                        <a href="/"><i class="fa fa-dashboard fa-fw"></i>Dashboard</a>
                    </li>
                    <li>
                        <a href="/web"><i class="fa fa-server fa-fw"></i>Websites</a>
                    </li>
                    <li>
                        <a href="/dns"><i class="fa fa-cloud fa-fw"></i>DNS</a>
                    </li>
                    <li>
                        <a href="/db"><i class="fa fa-database fa-fw"></i>Databases</a>
                    </li>
                    <li>
                        <a href="/mail"><i class="fa fa-at fa-fw"></i>E-Mail</a>
                    </li>
                    <li>
                        <a href="/ftp"><i class="fa fa-file-archive-o fa-fw"></i>FTP Users</a>
                    </li>
                </ul>
            </div>
            <!-- /.sidebar-collapse -->
        </div>
            <!-- /.sidebar-collapse -->
        </div>
        <!-- /.navbar-static-side -->
    </nav>

    <div id="page-wrapper">
        <br>
        <div class="row">
            <div class="col-lg-12">
                <div class="panel panel-default">
                    <div class="panel-heading clearfix">
                        <h4 class="panel-title pull-left" style="padding-top: 7.5px;">Records</h4>
                        <button type="button" class="btn pull-right btn-primary btn-sm" onclick="showDiv()">Add</button>
                    </div>
                    <!-- /.panel-heading -->
                    <div class="panel-body">
                        <table width="100%" class="table table-striped table-bordered table-hover" id="dataTables-example">
                            <thead>
                            <tr>
                                <th>Type</th>
                                <th>Name</th>
                                <th>Value</th>
                                <th>Prioridad</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for _, record := range records %}
                            <tr class="odd gradeX">
                                <td> {%s record.Type %} </td>
                                <td> {%s record.Name %} </td>
                                <td> {%s record.Value %} </td>
                                <td> {%s record.Priority %} </td>

                                <td class="center">
                                    <button type="button" class="btn btn-xs btn-primary" data-toggle="tooltip" data-placement="top" title="Modify record" onclick='modifyRecord({%d int(record.ID) %}, "{%s record.Type %}",  "{%s record.Name %}", "{%s record.Value %}",  "{%s record.Priority %}" )' ><i class="fa fa-list"></i></button>
                                    <button class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete record" onclick="location.href='removeRecord?id={%d int(record.ID) %}&zoneid={%s zoneid %}';"><i class="fa fa-trash-o"></i></button>
                                </td>
                            </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>


        <div id="form" class="col-lg-6" hidden="true" >
            <div class="panel panel-default">
                <div class="panel-heading">
                    Record Settings
                </div>
                <div class="panel-body">
                    <form id="addrecord" action="/records" onsubmit="return validateForm()" role=form method="post">
                        <input id="id" name="id" id="id" hidden="true" >
                        <input id="zoneid" name="zoneid" id="zoneid" value="{%s zoneid %}" hidden="true" >
                        Tipo
                        <select  class="form-control"  id="type" name="type" onchange="activatePriority()">
                            <option value="NS">NS</option>
                            <option value="A">A</option>
                            <option value="AAAA">AAAA</option>
                            <option value="CNAME">CNAME</option>
                            <option value="MX">MX</option>
                            <option value="PTR">PTR</option>
                            <option value="TXT">TXT</option>
                            <option value="SRV">SRV</option>
                            <option value="DS">DS</option>
                        </select>
                        <br>
                        Name
                        <input class="form-control" name="name" id="name">
                        <br>
                        Valor
                        <input class="form-control" name="value" id="value">
                        <br>
                        Prioridad
                        <input class="form-control" name="priority" id="priority" disabled="disabled">
                        <br>
                        <button type="submit" class="btn btn-default">Save</button>
                        <button type="button" class="btn btn-default" onclick="hideDiv()">Cancel</button>
                    </form>
                </div>
            </div>

        </div>
        <!-- /#page-wrapper -->

    </div>
    <!-- /#wrapper -->

    <!-- jQuery -->
    <script src="/vendor/jquery/jquery.min.js"></script>

    <!-- Bootstrap Core JavaScript -->
    <script src="/vendor/bootstrap/js/bootstrap.min.js"></script>

    <!-- Metis Menu Plugin JavaScript -->
    <script src="/vendor/metisMenu/metisMenu.min.js"></script>

    <!-- Morris Charts JavaScript -->
    <!--<script src="/vendor/raphael/raphael.min.js"></script>-->
    <!--<script src="/vendor/morrisjs/morris.min.js"></script>-->
    <!--<script src="../data/morris-data.js"></script>-->

    <!-- Custom Theme JavaScript -->
    <script src="/dist/js/sb-admin-2.js"></script>

</body>

</html>

{% endfunc %}
