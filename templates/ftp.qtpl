{% import "github.com/mkreder/dockerpanel/model" %}
{% func FtpTemplate(uftps []model.FTPUser, webs []model.Web, ftpConfig model.FtpConfig, error string) %}

<!DOCTYPE html>
<html lang="en">
<script type="text/javascript">
    var timeoutVar;

    function activateTimeout() {
        timeoutVar = setTimeout(function() {
            window.location.href = window.location.href;
        }, 5000);
    }
    activateTimeout()

    function desactivateTimeout() {
        clearTimeout(timeoutVar);
    }

    function validateForm() {
        var x = document.getElementById("domain").value;
        if (x == "" ) {
            alert("You must choose a domain");
            return false;
        }

        var y = document.getElementById("name").value;
        if (y == "" ) {
            alert("User name must be completed");
            return false;
        }

        var z = document.getElementById("password").value;
        if ( document.getElementById("password").getAttribute("disabled") == "disabled" ){
            } else {
            if (z == "" ) {
                alert("Password must be completed");
                return false;
            }
        }

    }

    function generatePassword() {
        if ( document.getElementById("password").getAttribute("disabled") == "disabled" ) {
            document.getElementById("btngenerar").innerHTML="Generate";
            document.getElementById("password").removeAttribute("disabled")
            document.getElementById("checkmostrar").removeAttribute("disabled");
        } else {
            document.getElementById("password").value = Math.random().toString(36).slice(-8);
        }
    }

    function showPassword() {
        if ( document.getElementById('checkmostrar').checked ) {
            document.getElementById('password').removeAttribute("type")
        } else {
            document.getElementById('password').setAttribute("type","password")
        }

    }


    function showDiv() {
        var x = document.getElementById('form');
        x.style.display = 'block';
        desactivateTimeout();
    }


    function hideDiv() {
        var x = document.getElementById('form');
        x.style.display = 'none';
        document.getElementById("name").value = "";
        document.getElementById("password").value = "";
        document.getElementById("domain").options[0].selected = true;
        if ( document.getElementById("password").getAttribute("disabled") == "disabled" ) {
            document.getElementById("btngenerar").innerHTML="Generate";
            document.getElementById("password").removeAttribute("disabled");
            document.getElementById("checkmostrar").removeAttribute("disabled");
        }
        activateTimeout();
    }

    function modifyFtp(id,name,domain) {
        var x = document.getElementById('form');
        document.getElementById("id").value = id;
        document.getElementById("name").value = name;
        document.getElementById("password").setAttribute("disabled","disabled")
        document.getElementById("btngenerar").innerHTML="Change";
        document.getElementById("checkmostrar").setAttribute("disabled","disabled")

        var seldomain = document.getElementById("domain");


        for (var i = 0; i < seldomain.options.length; i++) {
            if (seldomain.options[i].value == domain) {
                seldomain.options[i].selected = true;
            }
        }

        x.style.display = 'block';
        desactivateTimeout();
    }

</script>
<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Docker Panel</title>

    <!-- Bootstrap Core CSS -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <!-- MetisMenu CSS -->
    <link href="/vendor/metisMenu/metisMenu.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="/dist/css/sb-admin-2.css" rel="stylesheet">

    <!-- Morris Charts CSS -->
    <link href="/vendor/morrisjs/morris.css" rel="stylesheet">

    <!-- Custom Fonts -->
    <link href="/vendor/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css">

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
    <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->

</head>

<body>

{% if len(error) > 0 %}
<script type="text/javascript">
    window.alert("{%s error %}")
</script>
{% endif %}

<div id="wrapper">

    <!-- Navigation -->
    <nav class="navbar navbar-default navbar-static-top" role="navigation" style="margin-bottom: 0">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand" >Docker Panel</a>
        </div>
        <!-- /.navbar-header -->

        <ul class="nav navbar-top-links navbar-right">
            <!-- /.dropdown -->
            <li class="dropdown">
                <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                    <i class="fa fa-user fa-fw"></i> <i class="fa fa-caret-down"></i>
                </a>
                <ul class="dropdown-menu dropdown-user">
                    <li><a href="/profile"><i class="fa fa-user fa-fw"></i> Settings</a>
                    </li>
                    <li class="divider"></li>
                    <li><a href="/logout"><i class="fa fa-sign-out fa-fw"></i> Logout</a>
                    </li>
                </ul>
                <!-- /.dropdown-user -->
            </li>
            <!-- /.dropdown -->
        </ul>
        <!-- /.navbar-top-links -->


        <div class="navbar-default sidebar" role="navigation">
            <div class="sidebar-nav navbar-collapse">
                <ul class="nav" id="side-menu">
                    <li>
                        <a href="/"><i class="fa fa-dashboard fa-fw"></i>Dashboard</a>
                    </li>
                    <li>
                        <a href="/web"><i class="fa fa-server fa-fw"></i>Websites</a>
                    </li>
                    <li>
                        <a href="/dns"><i class="fa fa-cloud fa-fw"></i>DNS</a>
                    </li>
                    <li>
                        <a href="/db"><i class="fa fa-database fa-fw"></i>Databases</a>
                    </li>
                    <li>
                        <a href="/mail"><i class="fa fa-at fa-fw"></i>E-Mail</a>
                    </li>
                    <li>
                        <a href="/ftp"><i class="fa fa-file-archive-o fa-fw"></i>FTP Users</a>
                    </li>
                </ul>
            </div>
            <!-- /.sidebar-collapse -->
        </div>
            <!-- /.sidebar-collapse -->
        </div>
        <!-- /.navbar-static-side -->
    </nav>

    <div id="page-wrapper">
        <br>
        <div class="row">
            <div class="col-lg-12">
                <div class="panel panel-default">
                    <div class="panel-heading clearfix">
                        <h4 class="panel-title pull-left" style="padding-top: 7.5px;">FTP Users</h4>
                        <button type="button" class="btn pull-right btn-primary btn-sm" onclick="showDiv()">Add</button>
                    </div>
                    <!-- /.panel-heading -->
                    <div class="panel-body">
                        <table width="100%" class="table table-striped table-bordered table-hover" id="dataTables-example">
                            <thead>
                            <tr>
                                <th>Name</th>
                                <th>Domain</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                            <tbody>

                            {% code
                            var domain string
                            var id int
                            %}
                            {% for _, uftp := range uftps %}

                                {% for _, web := range webs %}
                                    {% if web.ID == uftp.WebID %}
                                      {%  code
                                        domain = web.Domain
                                        id = int(web.ID)
                                        %}
                                    {% endif %}
                                {% endfor %}
                            <tr class="odd gradeX">
                                <td> {%s uftp.Name %} </td>
                                <td> {%s domain %} </td>


                                {% switch uftp.Status %}
                                {% case 1 %}
                                <td>to configure</td>
                                {% case 2 %}
                                <td>configured</td>
                                {% case 3 %}
                                <td>deleting</td>
                                {% endswitch %}


                                <td class="center">
                                    <button type="button" class="btn btn-xs btn-primary" data-toggle="tooltip" data-placement="top" title="Modify FTP user" onclick='modifyFtp({%d int(uftp.ID) %}, "{%s uftp.Name %}", "{%d int(id) %}" )' ><i class="fa fa-list"></i></button>
                                    <button class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete FTP user" onclick="location.href='removeUserFtp?id={%d int(uftp.ID) %}';"><i class="fa fa-trash-o"></i></button>
                                </td>
                            </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                        <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#myModal" onclick="desactivateTimeout()">
                            Settings
                        </button>
                        <!-- Modal -->
                        <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                        <h4 class="modal-title" id="myModalLabel">Settings</h4>
                                    </div>
                                    <form id="ftpconfig" action="/ftpconfig" role=form method="post">
                                        <div class="modal-body">
                                            The following configuration allows you to define what permissions the anonymous FTP user will have over a special directory reserved for their exclusive use. This user cannot access other users directories. It can be used to allow someone to upload or download files without authentication.
                                            <br>
                                            <br>
                                            {% if ftpConfig.AnonRead == 1 %}
                                                <input name="anonRead" type="checkbox" value="1" checked="checked"> Permiso de lectura
                                            {% else %}
                                                <input name="anonRead" type="checkbox" value="1"> Permiso de lectura
                                            {% endif %}
                                            <br>
                                            {% if ftpConfig.AnonWrite == 1 %}
                                                <input name="anonWrite" type="checkbox" value="1" checked="checked"> Permiso de escritura
                                            {% else %}
                                                <input name="anonWrite" type="checkbox" value="1"> Permiso de escritura
                                            {% endif %}

                                        </div>

                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                                            <button type="submit" class="btn btn-primary">Save</button>
                                        </div>
                                    </form>
                                </div>
                                <!-- /.modal-content -->
                            </div>
                            <!-- /.modal-dialog -->
                        </div>
                        <!-- /.modal -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>


        <div id="form" class="col-lg-6" hidden="true" >
            <div class="panel panel-default">
                <div class="panel-heading">
                    FTP User Settings
                </div>
                <div class="panel-body">
                    <form id="addftp" action="/ftp" onsubmit="return validateForm()" role=form method="post">
                        <input id="id" name="id" hidden="true" >
                        <label>Settings</label>
                        <br>
                        Website
                        <select  class="form-control"  id="domain" name="domain">
                            <option disabled selected value> -- Choose domain -- </option>
                            {% for _, web := range webs %}
                              <option value="{%d int(web.ID) %}">{%s web.Domain %}</option>
                            {% endfor %}
                        </select>
                        <br>
                        User Name
                        <input class="form-control" name="name" id="name">
                        <br>

                        Password
                        <input class="form-control" name="password" id="password" type="password">
                        <button id="btngenerar" type="button" class="btn btn-default btn-sm" onclick="generatePassword()">Generate</button>
                        <input id="checkmostrar" name="checkmostrar" type="checkbox" value="true" onclick="showPassword()"> Show Password
                        <br>
                        <br>
                        <button type="submit" class="btn btn-default">Save</button>
                        <button type="button" class="btn btn-default" onclick="hideDiv()">Cancel</button>
                    </form>
                </div>
            </div>

        </div>
        <!-- /#page-wrapper -->

    </div>
    <!-- /#wrapper -->

    <!-- jQuery -->
    <script src="/vendor/jquery/jquery.min.js"></script>

    <!-- Bootstrap Core JavaScript -->
    <script src="/vendor/bootstrap/js/bootstrap.min.js"></script>

    <!-- Metis Menu Plugin JavaScript -->
    <script src="/vendor/metisMenu/metisMenu.min.js"></script>

    <!-- Morris Charts JavaScript -->
    <!--<script src="/vendor/raphael/raphael.min.js"></script>-->
    <!--<script src="/vendor/morrisjs/morris.min.js"></script>-->
    <!--<script src="../data/morris-data.js"></script>-->

    <!-- Custom Theme JavaScript -->
    <script src="/dist/js/sb-admin-2.js"></script>

</body>

</html>

{% endfunc %}
