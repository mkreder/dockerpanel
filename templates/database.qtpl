{% import "github.com/mkreder/dockerpanel/model" %}
{% func DatabaseTemplate(databases []model.Database, dbUsers []model.DatabaseUser, dbAssociations []model.DatabaseAssociation, error string) %}

<!DOCTYPE html>
<html lang="en">
<script src="https://code.jquery.com/jquery-1.11.2.min.js"></script>
<script type="text/javascript">

    $(document).ready(function(){
        $('a[data-toggle="tab"]').on('show.bs.tab', function(e) {
            localStorage.setItem('activeTab', $(e.target).attr('href'));
        });
        var activeTab = localStorage.getItem('activeTab');
        if(activeTab){
            $('#myTab a[href="' + activeTab + '"]').tab('show');
        }
    });

    var timeoutVar;

    function activateTimeout() {
        timeoutVar = setTimeout(function() {
            window.location.href = window.location.href;
        }, 5000);
    }
    activateTimeout()

    function deactivateTimeout() {
        clearTimeout(timeoutVar);
    }

    function validateUserForm() {
        var y = document.getElementById("name").value;
        if (y == "" ) {
            alert("Username must be completed");
            return false;
        }

        var z = document.getElementById("password").value;
        if ( document.getElementById("password").getAttribute("disabled") == "disabled" ){
        } else {
            if (z == "" ) {
                alert("Password must be completed");
                return false;
            }
        }

    }

    function generatePassword() {
        if ( document.getElementById("password").getAttribute("disabled") == "disabled" ) {
            document.getElementById("btngenerate").innerHTML="Generate";
            document.getElementById("password").removeAttribute("disabled")
            document.getElementById("checkshow").removeAttribute("disabled");
        } else {
            document.getElementById("password").value = Math.random().toString(36).slice(-8);
        }
    }

    function showPassword() {
        if ( document.getElementById('checkshow').checked ) {
            document.getElementById('password').removeAttribute("type")
        } else {
            document.getElementById('password').setAttribute("type","password")
        }

    }


    function showDivUser() {
        var x = document.getElementById('formUser');
        x.style.display = 'block';
        deactivateTimeout()
    }


    function hideDivUser() {
        var x = document.getElementById('formUser');
        x.style.display = 'none';
        document.getElementById("name").value = "";
        document.getElementById("password").value = "";
        if ( document.getElementById("password").getAttribute("disabled") == "disabled" ) {
            document.getElementById("btngenerate").innerHTML="Generate";
            document.getElementById("password").removeAttribute("disabled");
            document.getElementById("checkshow").removeAttribute("disabled");
        }
        activateTimeout()
    }

    function modifyUser(id,name) {
        var x = document.getElementById('formUser');
        document.getElementById("id").value = id;
        document.getElementById("name").value = name;
        document.getElementById("password").setAttribute("disabled","disabled")
        document.getElementById("btngenerate").innerHTML="Change";
        document.getElementById("checkshow").setAttribute("disabled","disabled")

        x.style.display = 'block';
        deactivateTimeout()
    }


    function showDivDB() {
        var x = document.getElementById('formDB');
        x.style.display = 'block';
        deactivateTimeout()
    }

    function hideDivDB() {
        var x = document.getElementById('formDB');
        x.style.display = 'none';
        document.getElementById("name").value = "";
        activateTimeout()
    }


    function hideRemoveDatabaseDiv(id) {
        var x = document.getElementById('formRemoveUDB' + id);
        x.style.display = 'none';
        document.getElementById("db" + id).options[0].selected = true;
        activateTimeout()
    }

    function hideAddUserDatabaseDiv() {
        var x = document.getElementById('formAddUDB');
        x.style.display = 'none';
        document.getElementById("seldb").options[0].selected = true;
        activateTimeout()
    }

    function validateDatabaseForm() {
        var y = document.getElementById("databaseName").value;
        if (y == "" ) {
            alert("Database name must be completed");
            return false;
        }
    }

    function validateAddUserDatabaseForm() {
        var y = document.getElementById("seldb").value;
        if (y == "" ) {
            alert("Database name must be completed");
            return false;
        }
    }

    function validateRemoveUserDatabaseForm(id) {
        var y = document.getElementById("db" + id).value;
        if (y == "" ) {
            alert("A database must be selected");
            return false;
        }
    }

    function validateRemoveIPForm(id) {
        var y = document.getElementById("ip" + id).value;
        if (y == "" ) {
            alert("An IP must be selected");
            return false;
        }
    }


    function modifyDatabase(id,name) {
        var x = document.getElementById('formDB');
        document.getElementById("databaseID").value = id;
        document.getElementById("databaseName").value = name;
        x.style.display = 'block';
        deactivateTimeout()

    }

    function addUserDatabase(id){
        var x = document.getElementById('formAddUDB');
        document.getElementById("idADB").value = id;
        x.style.display = 'block';
        deactivateTimeout()
    }

    function removeUserDatabase(id){
        var x = document.getElementById('formRemoveUDB' + id);
        x.style.display = 'block';
        deactivateTimeout()
    }

    function addIP(id){
        var x = document.getElementById('formAddIP');
        document.getElementById("idIP").value = id;
        x.style.display = 'block';
        deactivateTimeout()
    }

    function removeIP(id){
        var x = document.getElementById('formRemoveIP' + id);
        x.style.display = 'block';
        deactivateTimeout()
    }

    function validateAddIPForm(){
        var y = document.getElementById("ip").value;
        if (y == "" ) {
            alert("IP must be completed");
            return false;
        }

        if (/^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$|^%$/.test(y)) {
        }else {
            alert("Invalid IP");
            return false;
        }
    }

    function hideAddIPDiv(){
        var x = document.getElementById('formAddIP');
        x.style.display = 'none';
        document.getElementById("ip").value = "";
        activateTimeout()
    }

    function hideRemoveIPDiv(id) {
        var x = document.getElementById('formRemoveIP' + id);
        x.style.display = 'none';
        document.getElementById("ip" + id).options[0].selected = true;
        activateTimeout()
    }

    function setHref() {
        document.getElementById('phpmyadmin').href = window.location.protocol + "//" + window.location.hostname + ":58080/";
    }




</script>
<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Docker Panel</title>

    <!-- Bootstrap Core CSS -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <!-- MetisMenu CSS -->
    <link href="/vendor/metisMenu/metisMenu.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="/dist/css/sb-admin-2.css" rel="stylesheet">

    <!-- Morris Charts CSS -->
    <link href="/vendor/morrisjs/morris.css" rel="stylesheet">

    <!-- Custom Fonts -->
    <link href="/vendor/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css">

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
    <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->



</head>

<body onload="setHref()">>

{% if len(error) > 0 %}
<script type="text/javascript">
    window.alert("{%s error %}")


</script>
{% endif %}

<div id="wrapper">

    <!-- Navigation -->
    <nav class="navbar navbar-default navbar-static-top" role="navigation" style="margin-bottom: 0">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand">Docker Panel</a>
        </div>
        <!-- /.navbar-header -->

        <ul class="nav navbar-top-links navbar-right">
            <!-- /.dropdown -->
            <li class="dropdown">
                <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                    <i class="fa fa-user fa-fw"></i> <i class="fa fa-caret-down"></i>
                </a>
                <ul class="dropdown-menu dropdown-user">
                    <li><a href="/profile"><i class="fa fa-user fa-fw"></i> Settings</a>
                    </li>
                    <li class="divider"></li>
                    <li><a href="/logout"><i class="fa fa-sign-out fa-fw"></i> Logout</a>
                    </li>
                </ul>
                <!-- /.dropdown-user -->
            </li>
            <!-- /.dropdown -->
        </ul>
        <!-- /.navbar-top-links -->


        <div class="navbar-default sidebar" role="navigation">
            <div class="sidebar-nav navbar-collapse">
                <ul class="nav" id="side-menu">
                    <li>
                        <a href="/"><i class="fa fa-dashboard fa-fw"></i>Dashboard</a>
                    </li>
                    <li>
                        <a href="/web"><i class="fa fa-server fa-fw"></i>Websites</a>
                    </li>
                    <li>
                        <a href="/dns"><i class="fa fa-cloud fa-fw"></i>DNS</a>
                    </li>
                    <li>
                        <a href="/db"><i class="fa fa-database fa-fw"></i>Databases</a>
                    </li>
                    <li>
                        <a href="/mail"><i class="fa fa-at fa-fw"></i>E-Mail</a>
                    </li>
                    <li>
                        <a href="/ftp"><i class="fa fa-file-archive-o fa-fw"></i>FTP Users</a>
                    </li>
                </ul>
            </div>
            <!-- /.sidebar-collapse -->
        </div>
            <!-- /.sidebar-collapse -->
        </div>
        <!-- /.navbar-static-side -->
    </nav>

    <div id="page-wrapper">
        <br>
        <div class="row">
            <div class="col-lg-12">


                <div class="panel panel-default">
                    <div class="panel-heading">
                        Databases
                    </div>
                    <!-- /.panel-heading -->
                    <div class="panel-body">
                        <!-- Nav tabs -->
                        <ul class="nav nav-tabs" id="myTab">
                            <li class="active"><a href="#databases" data-toggle="tab">Databases</a>
                            </li>
                            <li><a href="#users" data-toggle="tab">Users</a>
                            </li>
                        </ul>

                        <!-- Tab panes -->
                        <div class="tab-content">
                            <div class="tab-pane fade" id="users">
                                <br>
                                <table width="100%" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Bases</th>
                                        <th>Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for _, user := range dbUsers %}
                                    <tr class="odd gradeX">
                                        <td> {%s user.Name %} </td>

                                        <td>
                                            {% for _, dba := range dbAssociations %}
                                                {% if user.ID == dba.DatabaseUserID %}
                                                    {% for _, db := range databases %}
                                                        {% if dba.DatabaseID == db.ID %}
                                                            {%s db.Name %}
                                                        {% endif %}
                                                    {% endfor %}
                                                {% endif %}
                                            {% endfor %}
                                        </td>


                                        <td class="center">
                                            <button type="button" class="btn btn-xs btn-success" data-toggle="tooltip" data-placement="top" title="Associate a database" onclick='addUDB({%d int(user.ID) %})' ><i class="fa fa-plus"></i></button>
                                            <button type="button" class="btn btn-xs btn-warning" data-toggle="tooltip" data-placement="top" title="Disassociate a database" onclick='removeUDB({%d int(user.ID) %})' ><i class="fa fa-minus"></i></button>
                                            <button type="button" class="btn btn-xs btn-primary" data-toggle="tooltip" data-placement="top" title="Edit user" onclick='modifyUser({%d int(user.ID) %}, "{%s user.Name %}"  )' ><i class="fa fa-list"></i></button>
                                            <button class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete user" onclick="location.href='removeUserDB?id={%d int(user.ID) %}';"><i class="fa fa-trash-o"></i></button>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                                <button type="button" class="btn btn-primary btn-sm" onclick="showDivUser()">Add</button>
                            </div>
                            <div class="tab-pane fade in active" id="databases">
                                <br>
                                <table width="100%" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Status</th>
                                        <th>Port</th>
                                        <th>Remota</th>
                                        <th>Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for _, db := range databases %}
                                    <tr class="odd gradeX">
                                        <td> {%s db.Name %} </td>


                                        {% switch db.Status %}
                                        {% case 1 %}
                                        <td>to configure</td>
                                        {% case 2 %}
                                        <td>configured</td>
                                        {% case 3 %}
                                        <td>active</td>
                                        {% case 4 %}
                                        <td>stopped</td>
                                        {% case 5 %}
                                        <td>deleting</td>
                                        {% endswitch %}

                                        <td>
                                            {% if db.ID < 10 %}
                                                300{%d int(db.ID) %}
                                            {% elseif db.ID < 100 %}
                                                30{%d int(db.ID) %}
                                            {% else %}
                                                3{%d int(db.ID) %}
                                            {% endif %}

                                        </td>
                                        <td>
                                            {% if len(db.IPs) == 0 %}
                                                no
                                            {% else %}
                                                {% for _, ip := range db.IPs %}
                                                    {%s ip.Value %}
                                                {% endfor %}
                                            {% endif %}
                                        </td>

                                        <td class="center">
                                            <button type="button" class="btn btn-xs btn-success" data-toggle="tooltip" data-placement="top" title="Add remote IP" onclick='addIP({%d int(db.ID) %})' ><i class="fa fa-plus"></i></button>
                                            <button type="button" class="btn btn-xs btn-warning" data-toggle="tooltip" data-placement="top" title="Delete remote IP" onclick='removeIP({%d int(db.ID) %})' ><i class="fa fa-minus"></i></button>
                                            <button type="button" class="btn btn-xs btn-primary" data-toggle="tooltip" data-placement="top" title="Edit database" onclick='modifyDB({%d int(db.ID) %}, "{%s db.Name %}")' ><i class="fa fa-list"></i></button>
                                           <button class="btn btn-xs btn-danger"data-toggle="tooltip" data-placement="top" title="Delete database"  onclick="location.href='removeDb?id={%d int(db.ID) %}';"><i class="fa fa-trash-o"></i></button>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                                <button type="button" class="btn btn-primary btn-sm" onclick="showDivDB()">Add</button>
                            </div>
                        </div>
                        <br>
                        <br>
                        <a class="btn btn-info btn-sm" href="/" id="phpmyadmin">PHPMyAdmin</a>
                    </div>
                    <!-- /.panel-body -->
                </div>





                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->



        <div id="formUser" class="col-lg-6" hidden="true" >
            <div class="panel panel-default">
                <div class="panel-heading">
                    User Settings
                </div>
                <div class="panel-body">
                    <form id="adduserdb" action="/userdb" onsubmit="return validateFormUser()" role=form method="post">
                        <input id="id" name="id" hidden="true" >
                        User Name
                        <input class="form-control" name="name" id="name">
                        <br>

                        Password
                        <input class="form-control" name="password" id="password" type="password">
                        <button id="btngenerar" type="button" class="btn btn-default btn-sm" onclick="generatePassword()">Generate</button>
                        <input id="checkmostrar" name="checkmostrar" type="checkbox" value="true" onclick="showPassword()"> Show Password
                        <br>

                        <br>
                        <button type="submit" class="btn btn-default">Save</button>
                        <button type="button" class="btn btn-default" onclick="hideDivUser()">Cancel</button>
                    </form>
                </div>
            </div>

        </div>



        <div id="formDB" class="col-lg-6" hidden="true" >
            <div class="panel panel-default">
                <div class="panel-heading">
                    Database Settings
                </div>
                <div class="panel-body">
                    <form id="adddb" action="/db" onsubmit="return validateFormDB()" role=form method="post">
                        <input id="databaseID" name="databaseID" hidden="true" >
                        Database Name
                        <input class="form-control" name="databaseName" id="databaseName">
                        <br>
                        <button type="submit" class="btn btn-default">Save</button>
                        <button type="button" class="btn btn-default" onclick="hideDivDB()">Cancel</button>
                    </form>
                </div>
            </div>
        </div>

        <div id="formAddUDB" class="col-lg-6" hidden="true" >
            <div class="panel panel-default">
                <div class="panel-heading">
                    Associate user to database
                </div>
                <div class="panel-body">
                    <form id="adduserdb" action="/adduserdb" onsubmit="return validateFormAddUDB()" role=form method="post">
                        <input id="idADB" name="userid" hidden="true" >
                        Database
                        <select  class="form-control"  id="selabd" name="dbid">
                            <option disabled selected value> -- Choose database -- </option>
                            {% for _, db := range databases %}
                            <option value="{%d int(db.ID) %}">{%s db.Name %}</option>
                            {% endfor %}
                        </select>
                        <br>
                        <button type="submit" class="btn btn-default">Save</button>
                        <button type="button" class="btn btn-default" onclick="hideDivAUDB()">Cancel</button>
                    </form>
                </div>
            </div>
        </div>

        {% for _, user := range dbUsers %}
        <div id="formRemoveUDB{%d int(user.ID) %}" class="col-lg-6" hidden="true" >
            <div class="panel panel-default">
                <div class="panel-heading">
                    Remove user permissions from database
                </div>
                <div class="panel-body">
                    <form id="removeuserdb" action="/removeuserdb" onsubmit="return validateFormRemoveUDB({%d int(user.ID) %})" role=form method="post">
                        <input id="userid" name="userid" value="{%d int(user.ID) %}" hidden="true" >
                        Database
                        <select  class="form-control"  id="db{%d int(user.ID) %}" name="dbid">
                            <option disabled selected value> -- Choose database -- </option>
                            {% for _, dba := range dbAssociations %}
                                {% if user.ID == dba.DatabaseUserID %}
                                    {% for _, db := range databases %}
                                        {% if dba.DatabaseID == db.ID %}
                                            <option value="{%d int(db.ID) %}">{%s db.Name %}</option>
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                        </select>
                        <br>
                        <button type="submit" class="btn btn-default">Save</button>
                        <button type="button" class="btn btn-default" onclick="hideDivRemoveDB({%d int(user.ID) %})">Cancel</button>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}

        <div id="formAddIP" class="col-lg-6" hidden="true" >
            <div class="panel panel-default">
                <div class="panel-heading">
                    Add remote IP
                </div>
                <div class="panel-body">
                    <form id="adddbip" action="/adddbip" onsubmit="return validateFormAddIP()" role=form method="post">
                        <input id="idIP" name="dbid" hidden="true" >
                        IP
                        <input id="ip" name="ip" class="form-control" >
                        <br>
                        <button type="submit" class="btn btn-default">Save</button>
                        <button type="button" class="btn btn-default" onclick="hideDivAIP()">Cancel</button>
                    </form>
                </div>
            </div>
        </div>


        {% for _, db := range databases %}
        <div id="formRemoveIP{%d int(db.ID) %}" class="col-lg-6" hidden="true" >
            <div class="panel panel-default">
                <div class="panel-heading">
                    Disassociate remote IP
                </div>
                <div class="panel-body">
                    <form id="removedbip" action="/removedbip" onsubmit="return validateFormRemoveIP({%d int(db.ID) %})" role=form method="post">
                        <input id="db{%d int(db.ID) %}" name="dbid" value="{%d int(db.ID) %}" hidden="true" >
                        IPs
                        <select  class="form-control"  id="ip{%d int(db.ID) %}" name="ip">
                            <option disabled selected value> -- Choose IP -- </option>
                            {% for _, ip := range db.IPs %}
                            <option value="{%s ip.Value %}">{%s ip.Value %}</option>
                            {% endfor %}
                        </select>
                        <br>
                        <button type="submit" class="btn btn-default">Save</button>
                        <button type="button" class="btn btn-default" onclick="hideDivRemoveIP({%d int(db.ID) %})">Cancel</button>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}


    </div>
        <!-- /#page-wrapper -->

    </div>
    <!-- /#wrapper -->

    <!-- jQuery -->
    <script src="/vendor/jquery/jquery.min.js"></script>

    <!-- Bootstrap Core JavaScript -->
    <script src="/vendor/bootstrap/js/bootstrap.min.js"></script>

    <!-- Metis Menu Plugin JavaScript -->
    <script src="/vendor/metisMenu/metisMenu.min.js"></script>

    <!-- Morris Charts JavaScript -->
    <!--<script src="/vendor/raphael/raphael.min.js"></script>-->
    <!--<script src="/vendor/morrisjs/morris.min.js"></script>-->
    <!--<script src="../data/morris-data.js"></script>-->

    <!-- Custom Theme JavaScript -->
    <script src="/dist/js/sb-admin-2.js"></script>

</body>

</html>

{% endfunc %}
